# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=your-resend-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Organization Email Domain (for validation)
# Only users with this email domain can sign up
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=geo.com

# Evaluation Reminder Secret
# For securing the cron job endpoint
EVALUATION_REMINDER_SECRET=your-evaluation-reminder-secret

# Redis (Upstash) - For rate limiting
# Required for production deployment with multiple instances
# Get your credentials from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Logging Configuration
# LOG_LEVEL: trace, debug, info, warn, error, fatal (default: info in production, debug in development)
# LOG_FORMAT: json or pretty (default: pretty in development, json in production)
LOG_LEVEL=info
LOG_FORMAT=json
