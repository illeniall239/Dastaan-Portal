# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=your-resend-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Organization Email Domain (for validation)
# Only users with this email domain can sign up
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=geo.com

# Evaluation Reminder Secret
# For securing the cron job endpoint
EVALUATION_REMINDER_SECRET=your-evaluation-reminder-secret
